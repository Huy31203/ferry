{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ferry",
  "mainBinaryName": "Ferry",
  "version": "0.2.0",
  "identifier": "io.ferry.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "devCsp": null,
      "assetProtocol": { "enable": true, "scope": { "allow": ["$APPDATA/backups/**"], "requireLiteralLeadingDot": false } }
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/gifsicle", "binaries/ffmpeg"],
    "resources": { "binaries/licenses/": "licenses/" },
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Shrinks images as you copy them.",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "installerHooks": "installer/hooks.nsh" }
    },
    "macOS": { "minimumSystemVersion": "13.0" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGNTFGMUFEMDc2NTEyQkUKUldTK0VtVUhyZkZScjRlQVdXOWNkWU1EeWdnQUdRSjVZVWhZUDJHT3pBYzhHZXlsQWVwR1l0MkIK",
      "endpoints": ["https://github.com/Huy31203/ferry/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
